# Google Maps Platform key with "Places API (New)" enabled. Used by `npm run reviews` at build time only.
GOOGLE_MAPS_API_KEY=
# Optional: pin the place (otherwise it is looked up by name)
GOOGLE_PLACE_ID=

# Optional server-only OpenAI Ads CAPI credential; provision in hosting secrets.
OPENAI_ADS_API_KEY=
# Must match PIXEL_ID in src/lib/oaiPixel.js; leave blank to use the shared default.
OPENAI_ADS_PIXEL_ID=
OPENAI_ADS_VALIDATE_ONLY=0
# Set only when the hosting proxy overwrites this header and prevents direct access.
OPENAI_ADS_TRUSTED_IP_HEADER=
