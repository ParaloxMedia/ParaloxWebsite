# Original project media (videos, screenshots) as supplied. The site uses the
# web-optimised copies in public/work/ and src/assets/projects/.
public/Images/Projects/

# Readable private pages (rate card prices, share links). Only the encrypted
# copy in public/sealed/ is committed: the repository is public.
private/rate-card/

# Source masters for project films (large originals); the site serves the web
# encodes in public/work/<project>/.
public/work/Renault/

# Full-size originals of Abubakker's event photos (hundreds of MB). The site uses
# the web-size copies in public/team/abubakker/web/.
public/team/abubakker/Builder Labs/
public/team/abubakker/Cocoon/
public/team/abubakker/Grokbot/
public/team/abubakker/Paralox/
