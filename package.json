{
  "name": "paralox-media-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Paralox Media website \u2014 React + Vite static site",
  "scripts": {
    "dev": "vite",
    "reviews": "node --env-file-if-exists=.env scripts/fetch-reviews.mjs",
    "prebuild": "npm run reviews",
    "build": "vite build",
    "prebuild:single": "npm run reviews",
    "build:single": "vite build --mode single",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  },
  "engines": {
    "node": ">=22.9"
  }
}
